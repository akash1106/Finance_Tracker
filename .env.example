NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_tracker?schema=public
LOG_LEVEL=info
JWT_SECRET=replace-this-development-secret-with-a-long-random-value-at-least-32-chars
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Optional Rate Limiting Overrides (window default: 15 mins)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100
# AUTH_RATE_LIMIT_MAX=10
# RATE_LIMIT_DISABLED=false
