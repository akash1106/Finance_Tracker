generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  accounts     Account[]
  incomeSources IncomeSource[]
  incomeTransactions IncomeTransaction[]
  categories   Category[]
  transactions Transaction[]
  fixedExpenses FixedExpense[]
  recurringTransactions RecurringTransaction[]
  savingsGoals SavingsGoal[]
  investments Investment[]
  loans Loan[]
  financialGoals FinancialGoal[]
  notifications Notification[]
  budgetTemplates BudgetTemplate[]
  monthlyBudgets MonthlyBudget[]

  @@map("users")
}

model Account {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   @db.VarChar(100)
  accountType    String   @map("account_type") @db.VarChar(30)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  incomeTransactions IncomeTransaction[]
  transactions       Transaction[]
  fixedExpenses      FixedExpense[]
  recurringTransactions RecurringTransaction[]
  savingsContributions SavingsContribution[]
  investmentContributions InvestmentContribution[]
  loanPayments LoanPayment[]

  @@index([userId])
  @@map("accounts")
}

model IncomeSource {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  isSalary  Boolean  @default(false) @map("is_salary")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  incomeTransactions IncomeTransaction[]

  @@index([userId])
  @@map("income_sources")
}

model IncomeTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  incomeSourceId        String   @map("income_source_id") @db.Uuid
  accountId             String   @map("account_id") @db.Uuid
  amount                Decimal  @db.Decimal(15, 2)
  receivedDate          DateTime @map("received_date") @db.Date
  description           String?
  isRecurring           Boolean  @default(false) @map("is_recurring")
  recurringTransactionId String?  @map("recurring_transaction_id") @db.Uuid
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  incomeSource          IncomeSource @relation(fields: [incomeSourceId], references: [id], onDelete: Restrict)
  account               Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  monthlyBudgets        MonthlyBudget[]
  recurringTransaction  RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: Restrict)

  @@index([userId, receivedDate])
  @@map("income_transactions")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(100)
  categoryType String   @map("category_type") @db.VarChar(30)
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  subcategories Subcategory[]
  transactions  Transaction[]
  budgetTemplateItems BudgetTemplateItem[]
  monthlyBudgetItems MonthlyBudgetItem[]
  fixedExpenses FixedExpense[]
  recurringTransactions RecurringTransaction[]

  @@unique([userId, name, categoryType])
  @@index([userId])
  @@map("categories")
}

model Subcategory {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]
  fixedExpenses FixedExpense[]
  recurringTransactions RecurringTransaction[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("subcategories")
}

model Transaction {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  transactionType         String   @map("transaction_type") @db.VarChar(30)
  amount                  Decimal  @db.Decimal(15, 2)
  categoryId              String?  @map("category_id") @db.Uuid
  subcategoryId           String?  @map("subcategory_id") @db.Uuid
  accountId               String   @map("account_id") @db.Uuid
  transactionDate         DateTime @map("transaction_date") @db.Date
  paymentMethod           String?  @map("payment_method") @db.VarChar(30)
  description             String?
  recurringTransactionId  String?  @map("recurring_transaction_id") @db.Uuid
  notes                   String?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  account                 Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category                Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory             Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  recurringTransaction    RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: Restrict)
  savingsContributions   SavingsContribution[]
  financialGoalContributions FinancialGoalContribution[]
  loanPayments LoanPayment[]
  investmentContributions InvestmentContribution[]

  @@index([userId, transactionDate])
  @@map("transactions")
}

model BudgetTemplate {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   @db.VarChar(100)
  description   String?
  isActive      Boolean  @default(false) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         BudgetTemplateItem[]
  monthlyBudgets MonthlyBudget[]

  @@index([userId])
  @@map("budget_templates")
}

model BudgetTemplateItem {
  id               String   @id @default(uuid()) @db.Uuid
  budgetTemplateId String   @map("budget_template_id") @db.Uuid
  categoryId       String   @map("category_id") @db.Uuid
  percentage       Decimal  @db.Decimal(5, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  budgetTemplate   BudgetTemplate @relation(fields: [budgetTemplateId], references: [id], onDelete: Cascade)
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([budgetTemplateId, categoryId])
  @@index([categoryId])
  @@map("budget_template_items")
}

model MonthlyBudget {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  budgetTemplateId    String   @map("budget_template_id") @db.Uuid
  incomeTransactionId String   @map("income_transaction_id") @db.Uuid
  month               Int
  year                Int
  allocatedAmount     Decimal  @map("allocated_amount") @db.Decimal(15, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  budgetTemplate      BudgetTemplate @relation(fields: [budgetTemplateId], references: [id], onDelete: Restrict)
  incomeTransaction   IncomeTransaction @relation(fields: [incomeTransactionId], references: [id], onDelete: Restrict)
  items               MonthlyBudgetItem[]

  @@unique([userId, year, month])
  @@index([userId, year, month])
  @@map("monthly_budgets")
}

model MonthlyBudgetItem {
  id              String   @id @default(uuid()) @db.Uuid
  monthlyBudgetId String   @map("monthly_budget_id") @db.Uuid
  categoryId      String   @map("category_id") @db.Uuid
  allocatedAmount Decimal  @map("allocated_amount") @db.Decimal(15, 2)
  spentAmount     Decimal  @default(0) @map("spent_amount") @db.Decimal(15, 2)
  percentage      Decimal  @db.Decimal(5, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  monthlyBudget   MonthlyBudget @relation(fields: [monthlyBudgetId], references: [id], onDelete: Cascade)
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([monthlyBudgetId, categoryId])
  @@index([categoryId])
  @@map("monthly_budget_items")
}

model FixedExpense {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   @db.VarChar(150)
  amount        Decimal  @db.Decimal(15, 2)
  categoryId    String   @map("category_id") @db.Uuid
  subcategoryId String   @map("subcategory_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  frequency     String   @db.VarChar(30)
  nextDueDate   DateTime @map("next_due_date") @db.Date
  startDate     DateTime @map("start_date") @db.Date
  endDate       DateTime? @map("end_date") @db.Date
  autoGenerate  Boolean  @default(true) @map("auto_generate")
  isActive      Boolean  @default(true) @map("is_active")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  account       Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, nextDueDate])
  @@map("fixed_expenses")
}

model RecurringTransaction {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @map("user_id") @db.Uuid
  name                   String   @db.VarChar(150)
  transactionType        String   @map("transaction_type") @db.VarChar(30)
  amount                 Decimal  @db.Decimal(15, 2)
  categoryId             String?  @map("category_id") @db.Uuid
  subcategoryId          String?  @map("subcategory_id") @db.Uuid
  accountId              String   @map("account_id") @db.Uuid
  paymentMethod          String?  @map("payment_method") @db.VarChar(30)
  frequency              String   @db.VarChar(30)
  startDate              DateTime @map("start_date") @db.Date
  endDate                DateTime? @map("end_date") @db.Date
  nextRunDate            DateTime @map("next_run_date") @db.Date
  isActive               Boolean  @default(true) @map("is_active")
  notes                  String?
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  account                Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category               Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory            Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  transactions           Transaction[]
  incomeTransactions     IncomeTransaction[]

  @@index([userId, nextRunDate])
  @@map("recurring_transactions")
}

model SavingsGoal {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   @db.VarChar(150)
  targetAmount  Decimal  @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal  @default(0) @map("current_amount") @db.Decimal(15, 2)
  targetDate    DateTime? @map("target_date") @db.Date
  description   String?
  status        String   @db.VarChar(30)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  contributions SavingsContribution[]

  @@index([userId, status])
  @@map("savings_goals")
}

model SavingsContribution {
  id               String   @id @default(uuid()) @db.Uuid
  savingsGoalId    String   @map("savings_goal_id") @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  amount           Decimal  @db.Decimal(15, 2)
  contributionDate DateTime @map("contribution_date") @db.Date
  transactionId     String   @map("transaction_id") @db.Uuid
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  savingsGoal      SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)
  account          Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([savingsGoalId, contributionDate])
  @@map("savings_contributions")
}

model Investment {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   @db.VarChar(150)
  investmentType String   @map("investment_type") @db.VarChar(30)
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  contributions  InvestmentContribution[]

  @@index([userId, investmentType])
  @@map("investments")
}

model InvestmentContribution {
  id             String   @id @default(uuid()) @db.Uuid
  investmentId   String   @map("investment_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  amount         Decimal  @db.Decimal(15, 2)
  investmentDate DateTime @map("investment_date") @db.Date
  transactionId  String   @map("transaction_id") @db.Uuid
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  investment     Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  account        Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction    Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([investmentId, investmentDate])
  @@map("investment_contributions")
}

model Loan {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  name            String   @db.VarChar(150)
  principalAmount Decimal  @map("principal_amount") @db.Decimal(15, 2)
  interestRate    Decimal  @map("interest_rate") @db.Decimal(5, 2)
  emiAmount       Decimal  @map("emi_amount") @db.Decimal(15, 2)
  tenureMonths    Int      @map("tenure_months")
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  status          String   @db.VarChar(30)
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments        LoanPayment[]

  @@index([userId, status])
  @@map("loans")
}

model LoanPayment {
  id            String   @id @default(uuid()) @db.Uuid
  loanId        String   @map("loan_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  amount        Decimal  @db.Decimal(15, 2)
  paymentDate   DateTime @map("payment_date") @db.Date
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  loan          Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([loanId, paymentDate])
  @@map("loan_payments")
}

model FinancialGoal {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  name          String   @db.VarChar(150)
  targetAmount  Decimal  @map("target_amount") @db.Decimal(15, 2)
  targetDate    DateTime? @map("target_date") @db.Date
  currentAmount Decimal  @default(0) @map("current_amount") @db.Decimal(15, 2)
  status        String   @db.VarChar(30)
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  contributions FinancialGoalContribution[]

  @@index([userId, status])
  @@map("financial_goals")
}

model FinancialGoalContribution {
  id               String   @id @default(uuid()) @db.Uuid
  financialGoalId  String   @map("financial_goal_id") @db.Uuid
  amount           Decimal  @db.Decimal(15, 2)
  contributionDate DateTime @map("contribution_date") @db.Date
  transactionId    String?  @map("transaction_id") @db.Uuid
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  financialGoal    FinancialGoal @relation(fields: [financialGoalId], references: [id], onDelete: Cascade)
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([financialGoalId, contributionDate])
  @@map("financial_goal_contributions")
}

model Notification {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  title            String   @db.VarChar(200)
  message          String
  notificationType String   @map("notification_type") @db.VarChar(50)
  referenceId      String?  @map("reference_id") @db.Uuid
  isRead           Boolean  @default(false) @map("is_read")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}
