generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  accounts     Account[]
  incomeSources IncomeSource[]
  incomeTransactions IncomeTransaction[]
  categories   Category[]
  transactions Transaction[]

  @@map("users")
}

model Account {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String   @db.VarChar(100)
  accountType    String   @map("account_type") @db.VarChar(30)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  incomeTransactions IncomeTransaction[]
  transactions       Transaction[]

  @@index([userId])
  @@map("accounts")
}

model IncomeSource {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  isSalary  Boolean  @default(false) @map("is_salary")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  incomeTransactions IncomeTransaction[]

  @@index([userId])
  @@map("income_sources")
}

model IncomeTransaction {
  id                    String   @id @default(uuid()) @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  incomeSourceId        String   @map("income_source_id") @db.Uuid
  accountId             String   @map("account_id") @db.Uuid
  amount                Decimal  @db.Decimal(15, 2)
  receivedDate          DateTime @map("received_date") @db.Date
  description           String?
  isRecurring           Boolean  @default(false) @map("is_recurring")
  recurringTransactionId String?  @map("recurring_transaction_id") @db.Uuid
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  incomeSource          IncomeSource @relation(fields: [incomeSourceId], references: [id], onDelete: Restrict)
  account               Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([userId, receivedDate])
  @@map("income_transactions")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  name         String   @db.VarChar(100)
  categoryType String   @map("category_type") @db.VarChar(30)
  description  String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  subcategories Subcategory[]
  transactions  Transaction[]

  @@unique([userId, name, categoryType])
  @@index([userId])
  @@map("categories")
}

model Subcategory {
  id          String   @id @default(uuid()) @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("subcategories")
}

model Transaction {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  transactionType         String   @map("transaction_type") @db.VarChar(30)
  amount                  Decimal  @db.Decimal(15, 2)
  categoryId              String?  @map("category_id") @db.Uuid
  subcategoryId           String?  @map("subcategory_id") @db.Uuid
  accountId               String   @map("account_id") @db.Uuid
  transactionDate         DateTime @map("transaction_date") @db.Date
  paymentMethod           String?  @map("payment_method") @db.VarChar(30)
  description             String?
  recurringTransactionId  String?  @map("recurring_transaction_id") @db.Uuid
  notes                   String?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  account                 Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category                Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategory             Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)

  @@index([userId, transactionDate])
  @@map("transactions")
}
